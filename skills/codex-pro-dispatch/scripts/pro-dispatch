#!/usr/bin/env python3
"""Plugin-local entry point for the Codex Pro Dispatch state helper."""

from pathlib import Path
import sys

if sys.version_info < (3, 9):
    print("pro-dispatch requires Python 3.9 or newer.", file=sys.stderr)
    raise SystemExit(1)

PLUGIN_ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(PLUGIN_ROOT / "src"))

from codex_pro_dispatch.cli import main

raise SystemExit(main())
